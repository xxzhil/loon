#!name = 农行开屏拦截
#!desc = 拦截农业银行 App 开屏广告相关的三条 mPaaS RPC 通道(按 Operation-Type 区分)。注意:getStartParam 是启动关键请求,默认关闭;开启后若 App 卡在启动页,立即关掉它。已缓存的开屏素材需等过期或清 App 缓存后才消失。
#!author = Muse
#!homepage = https://github.com/xxzhil/loon
#!icon = https://status.vyxh.top/pcdn-icon.png
#!date = 2026-11-14
#!tag = 去广告

[Argument]
UnionResource = switch, true, tag=拦截联合资源 getUnionResource, desc=开屏素材包的下发通道;也承载其他动态资源,可能影响活动位等内容
Mcube = switch, true, tag=拦截动态资源 mcube, desc=启动页动态卡片资源 alipay.client.mcube.custom.resource
StartParam = switch, false, tag=拦截启动参数 getStartParam, desc=开屏开关/时长/素材引用的配置通道;是启动关键 RPC,开启有卡启动页风险,确认前两个不够时再开

[Script]
http-request ^https?:\/\/mobilepaas\.abchina\.com\.cn(:\d+)?\/mgw\.htm script-path=https://raw.githubusercontent.com/xxzhil/loon/main/ABC-Splash-Block.js, requires-body=false, tag=农行开屏拦截, argument=[{UnionResource},{StartParam},{Mcube}]

[MITM]
hostname = mobilepaas.abchina.com.cn
